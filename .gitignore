# firmware/src/asuswrt-merlin.ng and firmware/src/am-toolchains are git
# submodules (see .gitmodules) pinned to exact upstream commits — tracked
# as gitlinks, not ignored. Their own multi-GB working-tree content only
# exists locally after `git submodule update --init` and is managed by
# each submodule's own .git, not this repo's ignore rules.
/firmware/out/
/firmware/.sources-pinned
# axos-build.sh's own state (lock, last-run.json, per-run logs) and the
# persistent ccache directory build.sh bind-mounts into the container —
# both local build state, not something to commit.
/firmware/.build-state/
/firmware/.ccache/

# Go
*.test
/cmd/**/*.out

# Device-specific captured facts that may be sensitive (serials, keys) unless
# explicitly reviewed and intentionally committed.
/docs/device-facts/*.local.*

# Editors / OS
.DS_Store
*.swp

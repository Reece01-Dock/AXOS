index 7998567acb..4b47a2946f 100644
--- a/release/src/router/shared/common_utils.c
+++ b/release/src/router/shared/common_utils.c
@@ -278,3 +278,30 @@ dm_unregister_app_restart_info(int pid)
 		printf("Unable to remove file %s. %s\n", buf, strerror(errno));
 	}
 }
+
+/* wl_ascii_str_to_hex_str() is normally declared/defined in wlif_utils.c
+ * under CONFIG_HOSTAPD, but wlif_utils.c/wlif_utils_ax.c are only compiled
+ * at all when CONFIG_BCMWL5 is "y" (see shared/Makefile) — an older,
+ * non-AX driver generation flag that's off for this HND_ROUTER_AX chip, so
+ * neither file is ever built here regardless of CONFIG_HOSTAPD. The
+ * prebuilt GT-AX6000 hostapd_config_6e.o (linked into rc unconditionally —
+ * see rc/Makefile and 0004-gt-ax6000-hostapd-config-6e-hostapd-decoupling.patch)
+ * needs this symbol anyway (confirmed via `nm`). It's a small, self-contained
+ * ASCII<->hex conversion with no hostapd-specific dependencies, so it's
+ * defined here instead, in a file that's genuinely always compiled — a
+ * verbatim copy of wlif_utils.c's CONFIG_HOSTAPD-gated version. */
+void wl_ascii_str_to_hex_str(char *ascii_str, uint16 ascii_len, char *hex_str, uint16 hex_len)
+{
+	int i = 0;
+
+	if (!ascii_str || !hex_str || !ascii_len || !hex_len) {
+		return;
+	}
+
+	while (ascii_str[i] != '\0' && i < (ascii_len - 1) && (i * 2) < (hex_len - 1)) {
+		snprintf((hex_str + i*2), 3,"%02X", ascii_str[i]);
+		i = i + 1;
+	}
+	hex_str[hex_len - 1] = '\0';
+	return;
+}
